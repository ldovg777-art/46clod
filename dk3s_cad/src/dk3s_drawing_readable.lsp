              (dk3s_dimtxt_v g_dk3s_zdim_re (+ g_dk3s_re_r re) 1.0 (strcat "O" (dk3s_num g_dk3s_re_d 0))))
  (dk3s_dim (dk3s_p zre1 (- g_dk3s_re_r re)) (dk3s_p zre2 (- g_dk3s_re_r re)) (dk3s_p 0.0 -3.0) 0.0 "")
